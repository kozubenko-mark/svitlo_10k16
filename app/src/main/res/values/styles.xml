<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppTheme.Light" />

    <style name="AppTheme.Light" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="cBg">@color/light_bg</item>
        <item name="cCard">@color/light_card</item>
        <item name="cRow">@color/light_row</item>
        <item name="cText">@color/light_text</item>
        <item name="cMuted">@color/light_muted</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="cBg">@color/dark_bg</item>
        <item name="cCard">@color/dark_card</item>
        <item name="cRow">@color/dark_row</item>
        <item name="cText">@color/dark_text</item>
        <item name="cMuted">@color/dark_muted</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
